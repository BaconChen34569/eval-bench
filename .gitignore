# 依赖与构建产物
node_modules/
dist/
.vite/

# 本地密钥：只允许存在于本地，不能进版本库
harness/.env
.env
.env.local
*.local

# 站点描述符由 Qoder Sites 工具生成
*.qoder.site

# 评测过程中的中间产物
harness/out/

# 评测语料：用 corpus/fetch.sh 重新拉取
corpus/repos/
corpus/tmp/

# 本地临时目录（打包中间产物、临时截图）
tmp/

# 源码包：由 site/scripts/pack-source.mjs 生成，内容就是本仓库本身，不进版本库
site/public/eval-bench-source.zip
