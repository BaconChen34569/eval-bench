# 本地密钥文件模板。复制成 harness/.env 再填自己的 key：
#
#   cp harness/.env.example harness/.env
#
# harness/.env 已被 .gitignore 忽略，不会进版本库。key 只留在本地文件里，
# 不要提交，也不要贴进任何对话、命令行或截图。
#
# ── 多模型档案 ────────────────────────────────────────────────────
# 一个档案 = 一家 OpenAI 兼容服务商 = 一组带前缀的环境变量。
# 前缀决定它归谁管：LLM_ 是默认档案，QWEN_ / GLM_ 是另外两家。
# 想加第四家（比如 Kimi），照抄一段、改个前缀就行，代码不用动。
#
#   <前缀>_PROFILE      命令行里用的名字，--model qwen
#   <前缀>_LABEL        站上展示用的名字
#   <前缀>_BASE_URL     OpenAI 兼容接口地址
#   <前缀>_API_KEY      密钥
#   <前缀>_MODEL        模型 id，跑 models 命令看接口上真实可用的 id
#   <前缀>_TEMPERATURE  普通对话模型填 0；推理模型留空（它不支持这个参数）
#   <前缀>_MAX_TOKENS   可选，单次输出上限
#   <前缀>_PRICE_PROMPT / _PRICE_COMPLETION / _PRICE_PROMPT_CACHE_HIT / _PRICE_CURRENCY
#                       单价（元 / 百万 token），照各家官方价目表填
#
# 常用命令：
#   node --experimental-strip-types src/cli.ts models
#       列出 .env 里所有档案，以及每个接口上可用的模型 id
#   node --experimental-strip-types src/cli.ts run ... --model qwen
#       换一个被测模型跑
#   node --experimental-strip-types src/cli.ts run ... --model qwen --judge-model glm
#       被测模型用 qwen，打分模型用 glm（排除 judge 偏袒自己那家模型）

# ===== DeepSeek：默认档案 =====
# https://api-docs.deepseek.com/zh-cn/quick_start/pricing/
LLM_PROFILE=deepseek
LLM_LABEL=DeepSeek
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-flash
LLM_TEMPERATURE=0

# 单次输出上限。留空则用服务端默认值；回答被截断时再填，比如 4096。
LLM_MAX_TOKENS=

# deepseek-flash 闲时价：缓存命中输入 0.02 / 缓存未命中输入 1 / 输出 4
LLM_PRICE_PROMPT=1
LLM_PRICE_COMPLETION=4
LLM_PRICE_PROMPT_CACHE_HIT=0.02
LLM_PRICE_CURRENCY=¥

# ===== 通义千问：阿里云百炼，OpenAI 兼容模式 =====
# key 在 https://bailian.console.aliyun.com/ 申请（先实名认证，新用户有免费 token）
# 模型 id 可以跑 models 命令确认接口上真实可用的
QWEN_PROFILE=qwen
QWEN_LABEL=通义千问
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=
QWEN_MODEL=qwen-plus
QWEN_TEMPERATURE=0

# qwen-plus 0-128K 档；换模型记得跟着官方价目表改
# https://help.aliyun.com/zh/model-studio/billing
QWEN_PRICE_PROMPT=0.8
QWEN_PRICE_COMPLETION=2
QWEN_PRICE_PROMPT_CACHE_HIT=0.08
QWEN_PRICE_CURRENCY=¥

# ===== 智谱 GLM：OpenAI 兼容接口，Flash 系列免费 =====
# key 在 https://open.bigmodel.cn/ 申请
# 官方 base_url 末尾带斜杠，漏了部分客户端会拼错路径
GLM_PROFILE=glm
GLM_LABEL=智谱 GLM
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_API_KEY=
GLM_MODEL=glm-4-flash
GLM_TEMPERATURE=0

# Flash 系列官方长期免费，单价填 0，成本记的就是真的 0
# https://open.bigmodel.cn/pricing
GLM_PRICE_PROMPT=0
GLM_PRICE_COMPLETION=0
GLM_PRICE_CURRENCY=¥
