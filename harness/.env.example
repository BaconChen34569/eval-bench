# 评测用的模型配置。复制成 .env 后填写，.env 已被 .gitignore 忽略，不会进版本库。
#
# 任何 OpenAI 兼容接口都可以用。已确认可达的：
#   DeepSeek    https://api.deepseek.com
#   阿里云百炼  https://dashscope.aliyuncs.com/compatible-mode/v1
#
# 填好密钥后先跑一次 `node --experimental-strip-types src/cli.ts models`，
# 它会列出这个账号实际可用的模型 id，把它填进 LLM_MODEL。

LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# 采样温度。留空则请求里不带这个字段——推理模型不支持它，传了会报错。
# 普通对话模型填 0 即可，保证同一批题的结果可复现。
LLM_TEMPERATURE=0

# 单次输出上限。留空则用服务端默认值；回答被截断时再填，比如 4096。
LLM_MAX_TOKENS=

# 单价（每百万 token），用于把 token 数折算成成本。
# 注意计价符号要和下面的一致：百炼按元，DeepSeek 官方价目表（中文站）也按元。
#
# DeepSeek deepseek-flash 闲时价：缓存命中输入 0.02 / 缓存未命中输入 1 / 输出 4
# 高峰时段官方价目表为两倍。填错会让成本数字失真。
LLM_PRICE_PROMPT=
LLM_PRICE_COMPLETION=
LLM_PRICE_PROMPT_CACHE_HIT=
LLM_PRICE_CURRENCY=¥
